  [plugins."apify-mcp-server@vincent-local"]
    enabled = false
  [plugins."browser@openai-bundled"]
    enabled = true
  [plugins."build-macos-apps@openai-curated"]
    enabled = true
  [plugins."claude-filesystem@vincent-local"]
